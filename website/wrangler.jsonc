{
  // siruscode.com: the static site in public/, served by Cloudflare Workers static assets.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "siruscode-site",
  "compatibility_date": "2026-10-12",
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
  "routes": [
    { "pattern": "siruscode.com", "custom_domain": true },
    { "pattern": "www.siruscode.com", "custom_domain": true }
  ]
}
